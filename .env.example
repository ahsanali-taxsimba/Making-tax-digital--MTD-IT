NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
FRONTEND_ORIGIN=http://localhost:2327

DATABASE_URL=postgresql://mtd:mtd@localhost:5432/mtd?schema=public

JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_MFA_SECRET=change-me-mfa-secret-at-least-32-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7
METRICS_TOKEN=
SWAGGER_ENABLED=true
ALLOW_DB_SEED=false

# 32-byte key as 64 hex chars. Used to encrypt HMRC tokens at rest.
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
TOKEN_ENCRYPTION_KEY_PREVIOUS=
# Enforce TOTP for platform admins, firm admins, and accountants.
MFA_ENFORCE=false
TLS_MIN_VERSION=TLSv1.3

# mock | sandbox | live  — mock uses canned HMRC; sandbox calls test-api.service.hmrc.gov.uk
HMRC_MODE=mock
HMRC_SANDBOX=false
HMRC_ENVIRONMENT=sandbox
HMRC_SANDBOX_CLIENT_ID=
HMRC_SANDBOX_CLIENT_SECRET=
HMRC_SANDBOX_REDIRECT_URI=http://localhost:2327/hmrc/callback
HMRC_SANDBOX_BASE_URL=https://test-api.service.hmrc.gov.uk
HMRC_SANDBOX_AUTHORIZE_URL=https://test-api.service.hmrc.gov.uk/oauth/authorize
HMRC_SANDBOX_TEST_USERS_FILE=
HMRC_LIVE_CLIENT_ID=
HMRC_LIVE_CLIENT_SECRET=
HMRC_LIVE_REDIRECT_URI=http://localhost:2327/hmrc/callback
HMRC_LIVE_BASE_URL=https://api.service.hmrc.gov.uk
HMRC_SANDBOX_AUTH_BASE=https://test-www.tax.service.gov.uk
HMRC_LIVE_AUTH_BASE=https://www.tax.service.gov.uk
HMRC_SCOPES=read:vat write:vat read:self-assessment write:self-assessment
# Browser Gov-Client-* headers ride x-mtd-fraud-prevention; the API fills Gov-Client-Public-IP from X-Forwarded-For.
HMRC_VENDOR_PUBLIC_IP=
HMRC_OBLIGATION_SYNC_MS=900000
HMRC_OBLIGATION_DUE_DAYS=14
# Set false only for local demos that submit without document/bank/journal evidence.
DIGITAL_LINKS_ENFORCE=true
# Legacy aliases still accepted: HMRC_CLIENT_ID, HMRC_CLIENT_SECRET, HMRC_REDIRECT_URI, HMRC_SANDBOX_API_BASE, HMRC_LIVE_API_BASE

# mock | live — mock Checkout/Portal/VAT invoices without Stripe credentials
STRIPE_MODE=mock
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_VAT_TAX_RATE_ID=
STRIPE_USAGE_SYNC_MS=3600000

# mock | live — mock lets local/dev run Open Banking without Yapily credentials
YAPILY_MODE=mock
YAPILY_BASE_URL=https://api.yapily.com
YAPILY_APPLICATION_KEY=
YAPILY_APPLICATION_SECRET=
YAPILY_CALLBACK_URL=http://localhost:3000/yapily/consent/callback
YAPILY_DEFAULT_INSTITUTION=modelo-sandbox

THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=60

# auto | tesseract | cloud | off — auto uses Tesseract when installed, else PDF/hint text
OCR_DRIVER=auto
OCR_ENDPOINT=
OCR_API_KEY=
OCR_TIMEOUT_MS=8000
