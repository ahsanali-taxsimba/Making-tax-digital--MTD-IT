NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
FRONTEND_ORIGIN=http://localhost:2327

DATABASE_URL=postgresql://mtd:mtd@localhost:5432/mtd?schema=public

JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

# 32-byte key as 64 hex chars. Used to encrypt HMRC tokens at rest.
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# mock | live  — mock lets local/dev run without HMRC credentials
HMRC_MODE=mock
HMRC_ENVIRONMENT=sandbox
HMRC_CLIENT_ID=
HMRC_CLIENT_SECRET=
HMRC_REDIRECT_URI=http://localhost:3000/mtd/callback
HMRC_SANDBOX_API_BASE=https://test-api.service.hmrc.gov.uk
HMRC_LIVE_API_BASE=https://api.service.hmrc.gov.uk
HMRC_SANDBOX_AUTH_BASE=https://test-www.tax.service.gov.uk
HMRC_LIVE_AUTH_BASE=https://www.tax.service.gov.uk
HMRC_SCOPES=read:vat write:vat read:self-assessment write:self-assessment

THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=60
