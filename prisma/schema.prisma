generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  ACCOUNTANT
  CLIENT
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum PlanType {
  STARTER
  PRACTICE
  ENTERPRISE
}

enum BillingStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
}

enum ClientType {
  INDIVIDUAL
  COMPANY
  LANDLORD
  PARTNERSHIP
}

enum HmrcEnvironment {
  SANDBOX
  LIVE
}

enum ObligationStatus {
  OPEN
  FULFILLED
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  ACCEPTED
  REJECTED
}

enum TaskType {
  MTD_VAT_RETURN
  MTD_ITSA_UPDATE
  MTD_ITSA_EOPS
  MTD_ITSA_FINAL_DECLARATION
  MTD_TOKEN_EXPIRING
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum NotificationType {
  OBLIGATION_FETCHED
  TOKEN_EXPIRING
  SUBMISSION_FAILED
  SUBMISSION_SUCCEEDED
}

enum WebhookEventType {
  CLIENT_CREATED
  MTD_CONNECTION_CREATED
  VAT_RETURN_SUBMITTED
  ITSA_UPDATE_SUBMITTED
}

enum LedgerAccountType {
  INCOME
  EXPENSE
  ASSET
  LIABILITY
  EQUITY
  CAPITAL
  BALANCE_SHEET
}

enum ChartProfile {
  LANDLORD
  SOLE_TRADER
  COMPANY
}

model Firm {
  id            String        @id @default(uuid())
  name          String
  address       String?
  contactEmail  String
  planType      PlanType      @default(STARTER)
  billingStatus BillingStatus @default(TRIAL)
  webhookSecret String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  users            User[]
  clients          Client[]
  auditLogs        AuditLog[]
  webhookEndpoints WebhookEndpoint[]
  webhookEvents    WebhookEvent[]
  tasks            Task[]
  notifications    Notification[]
}

model User {
  id             String     @id @default(uuid())
  name           String
  email          String     @unique
  role           UserRole
  firmId         String
  firm           Firm       @relation(fields: [firmId], references: [id])
  clientId       String?
  client         Client?    @relation(fields: [clientId], references: [id])
  status         UserStatus @default(ACTIVE)
  passwordHash   String?
  externalAuthId String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  notifications Notification[]
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
}

model Client {
  id                    String     @id @default(uuid())
  firmId                String
  firm                  Firm       @relation(fields: [firmId], references: [id])
  type                  ClientType
  name                  String
  utr                   String?
  vatRegistrationNumber String?
  vatRegion             String     @default("GB")
  niNumber              String?
  nino                  String?
  dateOfBirth           DateTime?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  portalUsers              User[]
  businesses               Business[]
  mtdConnections           MtdConnection[]
  vatObligations           VatObligation[]
  vatReturns               VatReturn[]
  vatPayments              VatPayment[]
  vatTransactionSummaries  VatTransactionSummary[]
  itsaObligations ItsaObligation[]
  itsaUpdates     ItsaUpdate[]
  itsaEops        ItsaEndOfPeriodStatement[]
  itsaFinals      ItsaFinalDeclaration[]
  ledgers         Ledger[]
  transactions    Transaction[]
  documents       SupportingDocument[]
  tasks           Task[]
  auditLogs       AuditLog[]

  @@index([firmId])
}

model Business {
  id             String   @id @default(uuid())
  clientId       String
  client         Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  hmrcBusinessId String?
  type           String
  tradingName    String
  accountingType String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  itsaObligations ItsaObligation[]
  itsaUpdates     ItsaUpdate[]
  itsaEops        ItsaEndOfPeriodStatement[]
}

model MtdConnection {
  id              String          @id @default(uuid())
  clientId        String
  client          Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  hmrcClientId    String
  scopes          String[]
  accessTokenEnc  String
  refreshTokenEnc String
  tokenExpiresAt  DateTime
  environment     HmrcEnvironment @default(SANDBOX)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([clientId, environment])
}

model OauthState {
  id          String          @id @default(uuid())
  state       String          @unique
  clientId    String
  userId      String
  environment HmrcEnvironment
  scopes      String[]
  expiresAt   DateTime
  createdAt   DateTime        @default(now())
}

model VatObligation {
  id            String           @id @default(uuid())
  clientId      String
  client        Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  periodKey     String
  start         DateTime
  end           DateTime
  due           DateTime
  status        ObligationStatus
  received      DateTime?
  correlationId String?
  rawPayload    Json?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  vatReturn     VatReturn?

  @@unique([clientId, periodKey])
}

model VatReturn {
  id                           String           @id @default(uuid())
  clientId                     String
  client                       Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  obligationId                 String?          @unique
  obligation                   VatObligation?   @relation(fields: [obligationId], references: [id])
  periodKey                    String
  periodStart                  DateTime?
  periodEnd                    DateTime?
  vatDueSales                  Decimal          @db.Decimal(14, 2)
  vatDueAcquisitions           Decimal          @db.Decimal(14, 2)
  totalVatDue                  Decimal          @db.Decimal(14, 2)
  vatReclaimedCurrPeriod       Decimal          @db.Decimal(14, 2)
  netVatDue                    Decimal          @db.Decimal(14, 2)
  totalValueSalesExVAT         Decimal          @db.Decimal(14, 2)
  totalValuePurchasesExVAT     Decimal          @db.Decimal(14, 2)
  totalValueGoodsSuppliedExVAT Decimal          @db.Decimal(14, 2)
  totalAcquisitionsExVAT       Decimal          @db.Decimal(14, 2)
  finalised                    Boolean
  status                       SubmissionStatus @default(DRAFT)
  formBundleNumber             String?
  chargeRefNumber              String?
  processingDate               DateTime?
  correlationId                String?
  rawPayload                   Json?
  createdAt                    DateTime         @default(now())
  updatedAt                    DateTime         @updatedAt
}

model VatTransactionSummary {
  id               String   @id @default(uuid())
  clientId         String
  client           Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  periodKey        String?
  periodStart      DateTime
  periodEnd        DateTime
  box1             Decimal  @db.Decimal(14, 2)
  box2             Decimal  @db.Decimal(14, 2)
  box3             Decimal  @db.Decimal(14, 2)
  box4             Decimal  @db.Decimal(14, 2)
  box5             Decimal  @db.Decimal(14, 2)
  box6             Decimal  @db.Decimal(14, 2)
  box7             Decimal  @db.Decimal(14, 2)
  box8             Decimal  @db.Decimal(14, 2)
  box9             Decimal  @db.Decimal(14, 2)
  transactionCount Int
  lines            Json
  excluded         Json
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([clientId, periodStart, periodEnd])
  @@index([clientId])
}

model VatPayment {
  id            String   @id @default(uuid())
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  amount        Decimal  @db.Decimal(14, 2)
  received      DateTime
  correlationId String?
  rawPayload    Json?
  createdAt     DateTime @default(now())
}

model ItsaObligation {
  id            String           @id @default(uuid())
  clientId      String
  client        Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  businessId    String?
  business      Business?        @relation(fields: [businessId], references: [id])
  type          String
  taxYear       String
  periodId      String?
  start         DateTime
  end           DateTime
  due           DateTime
  status        ObligationStatus
  received      DateTime?
  correlationId String?
  rawPayload    Json?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

model ItsaUpdate {
  id            String           @id @default(uuid())
  clientId      String
  client        Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  businessId    String?
  business      Business?        @relation(fields: [businessId], references: [id])
  taxYear       String
  periodId      String
  periodStart   DateTime
  periodEnd     DateTime
  incomes       Json
  expenses      Json
  status        SubmissionStatus @default(DRAFT)
  hmrcPeriodId  String?
  correlationId String?
  rawPayload    Json?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

model ItsaEndOfPeriodStatement {
  id                    String           @id @default(uuid())
  clientId              String
  client                Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  businessId            String?
  business              Business?        @relation(fields: [businessId], references: [id])
  taxYear               String
  typeOfBusiness        String
  accountingPeriodStart DateTime
  accountingPeriodEnd   DateTime
  finalised             Boolean
  status                SubmissionStatus @default(DRAFT)
  correlationId         String?
  rawPayload            Json?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
}

model ItsaFinalDeclaration {
  id            String           @id @default(uuid())
  clientId      String
  client        Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  taxYear       String
  calculationId String?
  finalised     Boolean
  status        SubmissionStatus @default(DRAFT)
  correlationId String?
  rawPayload    Json?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

model Ledger {
  id           String            @id @default(uuid())
  clientId     String
  client       Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  profile      ChartProfile      @default(SOLE_TRADER)
  code         Int
  name         String
  category     String
  type         LedgerAccountType
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  transactions Transaction[]

  @@unique([clientId, profile, code])
  @@index([clientId, profile])
}

model Transaction {
  id          String   @id @default(uuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  ledgerId    String?
  ledger      Ledger?  @relation(fields: [ledgerId], references: [id])
  date        DateTime
  description String
  amount      Decimal  @db.Decimal(14, 2)
  currency    String   @default("GBP")
  source      String?
  createdAt   DateTime @default(now())
}

model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String?
  actor       User?    @relation(fields: [actorUserId], references: [id])
  firmId      String?
  firm        Firm?    @relation(fields: [firmId], references: [id])
  clientId    String?
  client      Client?  @relation(fields: [clientId], references: [id])
  actionType  String
  metadata    Json
  createdAt   DateTime @default(now())

  @@index([firmId, createdAt])
  @@index([clientId, createdAt])
  @@index([actorUserId, createdAt])
}

model Task {
  id          String     @id @default(uuid())
  firmId      String
  firm        Firm       @relation(fields: [firmId], references: [id])
  clientId    String
  client      Client     @relation(fields: [clientId], references: [id])
  type        TaskType
  status      TaskStatus @default(OPEN)
  dueDate     DateTime?
  completedAt DateTime?
  title       String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Notification {
  id        String           @id @default(uuid())
  firmId    String
  firm      Firm             @relation(fields: [firmId], references: [id])
  userId    String?
  user      User?            @relation(fields: [userId], references: [id])
  type      NotificationType
  title     String
  body      String
  readAt    DateTime?
  metadata  Json?
  createdAt DateTime         @default(now())
}

model WebhookEndpoint {
  id        String             @id @default(uuid())
  firmId    String
  firm      Firm               @relation(fields: [firmId], references: [id], onDelete: Cascade)
  url       String
  events    WebhookEventType[]
  active    Boolean            @default(true)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
}

model WebhookEvent {
  id          String           @id @default(uuid())
  firmId      String
  firm        Firm             @relation(fields: [firmId], references: [id])
  eventType   WebhookEventType
  payload     Json
  deliveredAt DateTime?
  attempts    Int              @default(0)
  lastError   String?
  createdAt   DateTime         @default(now())
}

model SupportingDocument {
  id         String   @id @default(uuid())
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  fileName   String
  mimeType   String
  sizeBytes  Int
  storageKey String
  uploadedBy String?
  createdAt  DateTime @default(now())
}

model HmrcInteraction {
  id            String   @id @default(uuid())
  clientId      String?
  correlationId String   @unique
  method        String
  path          String
  statusCode    Int?
  requestBody   Json?
  responseBody  Json?
  errorCode     String?
  createdAt     DateTime @default(now())
}
