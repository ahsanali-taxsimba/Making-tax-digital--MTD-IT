generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  ACCOUNTANT
  CLIENT
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum PlanType {
  STARTER
  PRACTICE
  ENTERPRISE
}

enum BillingStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
}

enum ClientType {
  INDIVIDUAL
  COMPANY
  LANDLORD
  PARTNERSHIP
}

enum HmrcEnvironment {
  SANDBOX
  LIVE
}

enum ObligationStatus {
  OPEN
  FULFILLED
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  ACCEPTED
  REJECTED
}

enum TaskType {
  MTD_VAT_RETURN
  MTD_ITSA_UPDATE
  MTD_ITSA_EOPS
  MTD_ITSA_FINAL_DECLARATION
  MTD_TOKEN_EXPIRING
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum NotificationType {
  OBLIGATION_FETCHED
  TOKEN_EXPIRING
  SUBMISSION_FAILED
  SUBMISSION_SUCCEEDED
}

enum WebhookEventType {
  CLIENT_CREATED
  MTD_CONNECTION_CREATED
  VAT_RETURN_SUBMITTED
  ITSA_UPDATE_SUBMITTED
}

enum LedgerAccountType {
  INCOME
  EXPENSE
  ASSET
  LIABILITY
  EQUITY
  CAPITAL
  BALANCE_SHEET
}

enum ChartProfile {
  LANDLORD
  SOLE_TRADER
  COMPANY
}

model Firm {
  id            String        @id @default(uuid())
  name          String
  address       String?
  contactEmail  String
  planType      PlanType      @default(STARTER)
  billingStatus BillingStatus @default(TRIAL)
  webhookSecret String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  users            User[]
  clients          Client[]
  auditLogs        AuditLog[]
  webhookEndpoints WebhookEndpoint[]
  webhookEvents    WebhookEvent[]
  tasks            Task[]
  notifications    Notification[]
  journalEntries   JournalEntry[]
  bankAccounts     BankAccount[]
  accountingPeriods AccountingPeriod[]
}

model User {
  id             String     @id @default(uuid())
  name           String
  email          String     @unique
  role           UserRole
  firmId         String
  firm           Firm       @relation(fields: [firmId], references: [id])
  clientId       String?
  client         Client?    @relation(fields: [clientId], references: [id])
  status         UserStatus @default(ACTIVE)
  passwordHash   String?
  externalAuthId String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  notifications Notification[]
  journalEntries JournalEntry[]
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
}

model Client {
  id                    String     @id @default(uuid())
  firmId                String
  firm                  Firm       @relation(fields: [firmId], references: [id])
  type                  ClientType
  name                  String
  utr                   String?
  vatRegistrationNumber String?
  vatRegion             String     @default("GB")
  niNumber              String?
  nino                  String?
  dateOfBirth           DateTime?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  portalUsers              User[]
  businesses               Business[]
  mtdConnections           MtdConnection[]
  vatObligations           VatObligation[]
  vatReturns               VatReturn[]
  vatPayments              VatPayment[]
  vatTransactionSummaries  VatTransactionSummary[]
  itsaObligations ItsaObligation[]
  itsaUpdates     ItsaUpdate[]
  itsaEops        ItsaEndOfPeriodStatement[]
  itsaFinals      ItsaFinalDeclaration[]
  ledgers         Ledger[]
  transactions    Transaction[]
  documents       SupportingDocument[]
  tasks           Task[]
  auditLogs       AuditLog[]
  journalEntries  JournalEntry[]
  bankAccounts    BankAccount[]
  invoices        SalesInvoice[]
  bills           PurchaseBill[]
  customers       TradingParty[]
  accountingPeriods AccountingPeriod[]

  @@index([firmId])
}

model Business {
  id             String   @id @default(uuid())
  clientId       String
  client         Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  hmrcBusinessId String?
  type           String
  tradingName    String
  accountingType String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  itsaObligations ItsaObligation[]
  itsaUpdates     ItsaUpdate[]
  itsaEops        ItsaEndOfPeriodStatement[]
}

model MtdConnection {
  id              String          @id @default(uuid())
  clientId        String
  client          Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  hmrcClientId    String
  scopes          String[]
  accessTokenEnc  String
  refreshTokenEnc String
  tokenExpiresAt  DateTime
  environment     HmrcEnvironment @default(SANDBOX)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([clientId, environment])
}

model OauthState {
  id          String          @id @default(uuid())
  state       String          @unique
  clientId    String
  userId      String
  environment HmrcEnvironment
  scopes      String[]
  expiresAt   DateTime
  createdAt   DateTime        @default(now())
}

model VatObligation {
  id            String           @id @default(uuid())
  clientId      String
  client        Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  periodKey     String
  start         DateTime
  end           DateTime
  due           DateTime
  status        ObligationStatus
  received      DateTime?
  correlationId String?
  rawPayload    Json?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  vatReturn     VatReturn?

  @@unique([clientId, periodKey])
}

model VatReturn {
  id                           String           @id @default(uuid())
  clientId                     String
  client                       Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  obligationId                 String?          @unique
  obligation                   VatObligation?   @relation(fields: [obligationId], references: [id])
  periodKey                    String
  periodStart                  DateTime?
  periodEnd                    DateTime?
  vatDueSales                  Decimal          @db.Decimal(14, 2)
  vatDueAcquisitions           Decimal          @db.Decimal(14, 2)
  totalVatDue                  Decimal          @db.Decimal(14, 2)
  vatReclaimedCurrPeriod       Decimal          @db.Decimal(14, 2)
  netVatDue                    Decimal          @db.Decimal(14, 2)
  totalValueSalesExVAT         Decimal          @db.Decimal(14, 2)
  totalValuePurchasesExVAT     Decimal          @db.Decimal(14, 2)
  totalValueGoodsSuppliedExVAT Decimal          @db.Decimal(14, 2)
  totalAcquisitionsExVAT       Decimal          @db.Decimal(14, 2)
  finalised                    Boolean
  status                       SubmissionStatus @default(DRAFT)
  formBundleNumber             String?
  chargeRefNumber              String?
  processingDate               DateTime?
  correlationId                String?
  rawPayload                   Json?
  createdAt                    DateTime         @default(now())
  updatedAt                    DateTime         @updatedAt
}

model VatTransactionSummary {
  id               String   @id @default(uuid())
  clientId         String
  client           Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  periodKey        String?
  periodStart      DateTime
  periodEnd        DateTime
  box1             Decimal  @db.Decimal(14, 2)
  box2             Decimal  @db.Decimal(14, 2)
  box3             Decimal  @db.Decimal(14, 2)
  box4             Decimal  @db.Decimal(14, 2)
  box5             Decimal  @db.Decimal(14, 2)
  box6             Decimal  @db.Decimal(14, 2)
  box7             Decimal  @db.Decimal(14, 2)
  box8             Decimal  @db.Decimal(14, 2)
  box9             Decimal  @db.Decimal(14, 2)
  transactionCount Int
  lines            Json
  excluded         Json
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([clientId, periodStart, periodEnd])
  @@index([clientId])
}

model VatPayment {
  id            String   @id @default(uuid())
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  amount        Decimal  @db.Decimal(14, 2)
  received      DateTime
  correlationId String?
  rawPayload    Json?
  createdAt     DateTime @default(now())
}

model ItsaObligation {
  id            String           @id @default(uuid())
  clientId      String
  client        Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  businessId    String?
  business      Business?        @relation(fields: [businessId], references: [id])
  type          String
  taxYear       String
  periodId      String?
  start         DateTime
  end           DateTime
  due           DateTime
  status        ObligationStatus
  received      DateTime?
  correlationId String?
  rawPayload    Json?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

model ItsaUpdate {
  id            String           @id @default(uuid())
  clientId      String
  client        Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  businessId    String?
  business      Business?        @relation(fields: [businessId], references: [id])
  taxYear       String
  periodId      String
  periodStart   DateTime
  periodEnd     DateTime
  incomes       Json
  expenses      Json
  status        SubmissionStatus @default(DRAFT)
  hmrcPeriodId  String?
  correlationId String?
  rawPayload    Json?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

model ItsaEndOfPeriodStatement {
  id                    String           @id @default(uuid())
  clientId              String
  client                Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  businessId            String?
  business              Business?        @relation(fields: [businessId], references: [id])
  taxYear               String
  typeOfBusiness        String
  accountingPeriodStart DateTime
  accountingPeriodEnd   DateTime
  finalised             Boolean
  status                SubmissionStatus @default(DRAFT)
  correlationId         String?
  rawPayload            Json?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
}

model ItsaFinalDeclaration {
  id            String           @id @default(uuid())
  clientId      String
  client        Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  taxYear       String
  calculationId String?
  finalised     Boolean
  status        SubmissionStatus @default(DRAFT)
  correlationId String?
  rawPayload    Json?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

model ItsaAccountMapping {
  id                         String       @id @default(uuid())
  profile                    ChartProfile
  code                       Int
  bucket                     String
  category                   String
  hmrcKey                    String
  includedInQuarterlyUpdate  Boolean
  createdAt                  DateTime     @default(now())
  updatedAt                  DateTime     @updatedAt

  @@unique([profile, code])
  @@index([profile])
}

model Ledger {
  id              String            @id @default(uuid())
  clientId        String
  client          Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  profile         ChartProfile      @default(SOLE_TRADER)
  code            Int
  name            String
  category        String
  type            LedgerAccountType
  isActive        Boolean           @default(true)
  openingBalance  Decimal           @default(0) @db.Decimal(14, 2)
  currentBalance  Decimal           @default(0) @db.Decimal(14, 2)
  chartOfAccountId String?
  chartOfAccount   ChartOfAccount?  @relation(fields: [chartOfAccountId], references: [id])
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  transactions    Transaction[]
  journalLines    JournalLine[]

  @@unique([clientId, profile, code])
  @@index([clientId, profile])
}

model Transaction {
  id          String   @id @default(uuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  ledgerId    String?
  ledger      Ledger?  @relation(fields: [ledgerId], references: [id])
  date        DateTime
  description String
  amount      Decimal  @db.Decimal(14, 2)
  currency    String   @default("GBP")
  source      String?
  createdAt   DateTime @default(now())
}

model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String?
  actor       User?    @relation(fields: [actorUserId], references: [id])
  firmId      String?
  firm        Firm?    @relation(fields: [firmId], references: [id])
  clientId    String?
  client      Client?  @relation(fields: [clientId], references: [id])
  actionType  String
  metadata    Json
  createdAt   DateTime @default(now())

  @@index([firmId, createdAt])
  @@index([clientId, createdAt])
  @@index([actorUserId, createdAt])
}

model Task {
  id          String     @id @default(uuid())
  firmId      String
  firm        Firm       @relation(fields: [firmId], references: [id])
  clientId    String
  client      Client     @relation(fields: [clientId], references: [id])
  type        TaskType
  status      TaskStatus @default(OPEN)
  dueDate     DateTime?
  completedAt DateTime?
  title       String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Notification {
  id        String           @id @default(uuid())
  firmId    String
  firm      Firm             @relation(fields: [firmId], references: [id])
  userId    String?
  user      User?            @relation(fields: [userId], references: [id])
  type      NotificationType
  title     String
  body      String
  readAt    DateTime?
  metadata  Json?
  createdAt DateTime         @default(now())
}

model WebhookEndpoint {
  id        String             @id @default(uuid())
  firmId    String
  firm      Firm               @relation(fields: [firmId], references: [id], onDelete: Cascade)
  url       String
  events    WebhookEventType[]
  active    Boolean            @default(true)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
}

model WebhookEvent {
  id          String           @id @default(uuid())
  firmId      String
  firm        Firm             @relation(fields: [firmId], references: [id])
  eventType   WebhookEventType
  payload     Json
  deliveredAt DateTime?
  attempts    Int              @default(0)
  lastError   String?
  createdAt   DateTime         @default(now())
}

model SupportingDocument {
  id         String   @id @default(uuid())
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  fileName   String
  mimeType   String
  sizeBytes  Int
  storageKey String
  uploadedBy String?
  createdAt  DateTime @default(now())
}

enum JournalSource {
  MANUAL
  BANK_FEED
  IMPORT
  INVOICE
  BILL
}

enum TaxCodeKind {
  VAT_STANDARD
  VAT_REDUCED
  VAT_ZERO
  VAT_EXEMPT
  NO_VAT
}

enum BankTxnDirection {
  CREDIT
  DEBIT
}

enum BankTxnStatus {
  UNMATCHED
  MATCHED
  IGNORED
  RECONCILED
}

enum DocumentStatus {
  DRAFT
  POSTED
  VOID
}

enum ReconciliationStatus {
  OPEN
  COMPLETE
}

enum PartyKind {
  CUSTOMER
  SUPPLIER
}

model ChartOfAccount {
  id        String            @id @default(uuid())
  code      Int
  name      String
  type      LedgerAccountType
  profile   ChartProfile
  isActive  Boolean           @default(true)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  ledgers   Ledger[]

  @@unique([profile, code])
}

model TaxCode {
  id        String      @id @default(uuid())
  code      String      @unique
  name      String
  rate      Decimal     @db.Decimal(5, 2)
  type      TaxCodeKind
  createdAt DateTime    @default(now())
  journalLines JournalLine[]
  invoiceLines SalesInvoiceLine[]
  billLines    PurchaseBillLine[]
}

model AccountingPeriod {
  id        String   @id @default(uuid())
  firmId    String
  firm      Firm     @relation(fields: [firmId], references: [id])
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  start     DateTime
  end       DateTime
  locked    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([clientId, start, end])
}

model JournalEntry {
  id              String        @id @default(uuid())
  firmId          String
  firm            Firm          @relation(fields: [firmId], references: [id])
  clientId        String
  client          Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  date            DateTime
  reference       String?
  description     String
  source          JournalSource @default(MANUAL)
  createdByUserId String?
  createdBy       User?         @relation(fields: [createdByUserId], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  lines           JournalLine[]
  bankMatches     BankTransaction[]
  invoice         SalesInvoice?
  bill            PurchaseBill?

  @@index([clientId, date])
}

model JournalLine {
  id              String       @id @default(uuid())
  journalEntryId  String
  journal         JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  ledgerAccountId String
  ledger          Ledger       @relation(fields: [ledgerAccountId], references: [id])
  debit           Decimal      @default(0) @db.Decimal(14, 2)
  credit          Decimal      @default(0) @db.Decimal(14, 2)
  taxCodeId       String?
  taxCode         TaxCode?     @relation(fields: [taxCodeId], references: [id])
  description     String?
}

model TradingParty {
  id        String    @id @default(uuid())
  clientId  String
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  kind      PartyKind
  name      String
  createdAt DateTime  @default(now())
  invoices  SalesInvoice[]
  bills     PurchaseBill[]
}

model SalesInvoice {
  id          String         @id @default(uuid())
  clientId    String
  client      Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  customerId  String
  customer    TradingParty   @relation(fields: [customerId], references: [id])
  date        DateTime
  dueDate     DateTime
  status      DocumentStatus @default(DRAFT)
  netTotal    Decimal        @db.Decimal(14, 2)
  vatTotal    Decimal        @db.Decimal(14, 2)
  grossTotal  Decimal        @db.Decimal(14, 2)
  journalId   String?        @unique
  journal     JournalEntry?  @relation(fields: [journalId], references: [id])
  lines       SalesInvoiceLine[]
  createdAt   DateTime       @default(now())
}

model SalesInvoiceLine {
  id          String       @id @default(uuid())
  invoiceId   String
  invoice     SalesInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  net         Decimal      @db.Decimal(14, 2)
  taxCodeId   String?
  taxCode     TaxCode?     @relation(fields: [taxCodeId], references: [id])
  vat         Decimal      @db.Decimal(14, 2)
  ledgerId    String?
}

model PurchaseBill {
  id          String         @id @default(uuid())
  clientId    String
  client      Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  supplierId  String
  supplier    TradingParty   @relation(fields: [supplierId], references: [id])
  date        DateTime
  dueDate     DateTime
  status      DocumentStatus @default(DRAFT)
  netTotal    Decimal        @db.Decimal(14, 2)
  vatTotal    Decimal        @db.Decimal(14, 2)
  grossTotal  Decimal        @db.Decimal(14, 2)
  journalId   String?        @unique
  journal     JournalEntry?  @relation(fields: [journalId], references: [id])
  lines       PurchaseBillLine[]
  createdAt   DateTime       @default(now())
}

model PurchaseBillLine {
  id          String       @id @default(uuid())
  billId      String
  bill        PurchaseBill @relation(fields: [billId], references: [id], onDelete: Cascade)
  description String
  net         Decimal      @db.Decimal(14, 2)
  taxCodeId   String?
  taxCode     TaxCode?     @relation(fields: [taxCodeId], references: [id])
  vat         Decimal      @db.Decimal(14, 2)
  ledgerId    String?
}

model BankAccount {
  id            String            @id @default(uuid())
  firmId        String
  firm          Firm              @relation(fields: [firmId], references: [id])
  clientId      String
  client        Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name          String
  sortCode      String?
  accountNumber String?
  provider      String?
  externalId    String?
  ledgerId      String?
  createdAt     DateTime          @default(now())
  transactions  BankTransaction[]
  sessions      ReconciliationSession[]
}

model BankTransaction {
  id                    String           @id @default(uuid())
  bankAccountId         String
  bankAccount           BankAccount      @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  date                  DateTime
  amount                Decimal          @db.Decimal(14, 2)
  type                  BankTxnDirection
  description           String
  externalRef           String?
  matchedJournalEntryId String?
  matchedJournal        JournalEntry?    @relation(fields: [matchedJournalEntryId], references: [id])
  status                BankTxnStatus    @default(UNMATCHED)
  createdAt             DateTime         @default(now())
}

model ReconciliationSession {
  id            String                @id @default(uuid())
  bankAccountId String
  bankAccount   BankAccount           @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  periodStart   DateTime
  periodEnd     DateTime
  status        ReconciliationStatus  @default(OPEN)
  createdByUserId String?
  statementBalance Decimal?           @db.Decimal(14, 2)
  createdAt     DateTime              @default(now())
}

model HmrcInteraction {
  id            String   @id @default(uuid())
  clientId      String?
  correlationId String   @unique
  method        String
  path          String
  statusCode    Int?
  requestBody   Json?
  responseBody  Json?
  errorCode     String?
  createdAt     DateTime @default(now())
}
